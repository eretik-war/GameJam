{
  "name": "gamejam-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node tools/dev-server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node tools/run-tests.mjs",
    "test:sync": "node --test tools/sync.test.mjs",
    "sync": "node tools/sync.mjs",
    "sync:status": "node tools/sync.mjs status",
    "sync:compare": "node tools/sync.mjs compare",
    "sync:save": "node tools/sync.mjs save",
    "sync:history": "node tools/sync.mjs history",
    "sync:pause": "node tools/sync.mjs pause",
    "sync:resume": "node tools/sync.mjs resume",
    "sync:pull": "node tools/sync.mjs pull",
    "sync:push": "node tools/sync.mjs push",
    "sync:publish": "node tools/sync.mjs publish",
    "sync:task": "node tools/sync.mjs task",
    "sync:plan": "node tools/sync.mjs plan",
    "bench:sync": "node tools/sync-bench.mjs",
    "sync:auto:install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/sync-auto.ps1 -Action install",
    "sync:auto:status": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/sync-auto.ps1 -Action status",
    "sync:auto:remove": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/sync-auto.ps1 -Action remove",
    "validate": "node tools/validate.mjs",
    "build": "node tools/build.mjs",
    "build:offline": "node tools/build.mjs --offline",
    "check:game": "npm run typecheck && npm test && npm run build:offline && npm run validate",
    "check": "npm run check:game && npm run test:sync"
  },
  "dependencies": { "pixi.js": "7.4.3" },
  "devDependencies": { "typescript": "5.9.3", "esbuild": "0.25.12", "@types/node": "22.15.30" }
}
